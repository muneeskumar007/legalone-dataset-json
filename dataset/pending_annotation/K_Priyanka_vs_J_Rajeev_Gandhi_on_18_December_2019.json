  "legal_principles": [
    {
      "principle": "Matrimonial cases pending on the file of a Judge, Family Court, shall not be withdrawn and transferred to the Court of Senior Civil Judge.",
      "held": "The jurisdiction of the civil Court is ousted by Section 8 of the Family Courts Act.",
      "applicable_acts_sections": [
        "Family Courts Act — Section 8"
      ],
