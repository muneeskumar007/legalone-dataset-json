  "legal_principles": [
    {
      "principle": "The fact of filing cases cannot be regarded as 'cruelty' within the meaning given to the phrase under Section 13(1)(i-a) of the Hindu Marriage Act, 1955.",
      "held": "Merely the fact of filing cases cannot be regarded as 'cruelty'.",
