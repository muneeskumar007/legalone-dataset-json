  "legal_principles": [
    {
      "principle": "A child of a marriage which is null and void shall be legitimate if the marriage had been valid.",
      "held": "Any child of such marriage who had been legitimate if the marriage had been valid, shall be legitimate, whether such child is born before or after the commencement of the Marriage Laws (Amendment) Act, 1976.",
      "applicable_acts_sections": [
        "Hindu Marriage Act, 1955 — Section 16"
      ],
