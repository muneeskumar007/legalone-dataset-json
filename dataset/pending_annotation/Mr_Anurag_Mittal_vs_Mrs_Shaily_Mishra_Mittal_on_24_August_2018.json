  "legal_principles": [
    {
      "principle": "A breach of a condition does not render the marriage void.",
      "held": "Even where a marriage in breach of a certain condition is made punishable yet the law does not treat it as void.",
      "applicable_acts_sections": [
        "Hindu Marriage Act, 1955 — Section 5"
      ],
      "cited_cases": [
        "Craies on Statute Law, 7th Edn., P. 263 and 264"
      ],
