      "principle_id": "LP_001"
    },
    {
      "principle": "The absence of an express provision does not infer nullity.",
      "held": "In the absence of an express provision it is not possible to infer nullity in respect of a marriage contracted by a person under incapacity prescribed by the proviso.",
      "applicable_acts_sections": [
        "Hindu Marriage Act, 1955"
      ],
      "cited_cases": [
