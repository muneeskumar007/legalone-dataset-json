  "legal_principles": [
    {
      "principle": "Cognizance of an offence punishable under Chapter XX of the Indian Penal Code can only be taken upon a private complaint by the aggrieved person.",
      "held": "On careful reading of aforesaid provisions, it appears that Section 494 IPC falls under Chapter XX of IPC. Therefore, cognizance of the said offence can only be taken upon a private complaint by the aggrieved person and not on the basis of a police report.",
