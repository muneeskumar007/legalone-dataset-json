  "legal_principles": [
    {
      "principle": "The Trial Court is not relieved of its obligation to record findings of various aspects that fall for consideration, even where the defendant remains ex parte.",
      "held": "Time and again, the Supreme Court held that even where the defendant in a suit remained ex parte, the Trial Court is not relieved of its obligation to record findings of various aspects that fall for consideration.",
