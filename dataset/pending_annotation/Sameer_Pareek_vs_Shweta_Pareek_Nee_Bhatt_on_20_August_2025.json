  "legal_principles": [
    {
      "principle": "A marriage can be annulled if the consent of the respondent was obtained by fraud as to any material fact or circumstance concerning the respondent.",
      "held": "Section 12(1)(c) of the HMA allows annulment of a marriage on specific grounds, including fraud ...as to any material fact or circumstance concerning the respondent.",
