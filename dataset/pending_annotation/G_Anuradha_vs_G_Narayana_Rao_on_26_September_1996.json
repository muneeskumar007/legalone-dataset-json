  "legal_principles": [
    {
      "principle": "A marriage can be annulled if the consent of one party was obtained by wilful suppression of material facts.",
      "held": "The consent of the respondent for the marriage has been obtained by wilful suppression of the above material facts relating to the appellant and as such the marriage is liable to be annulled.",
