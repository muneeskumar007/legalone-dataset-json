  "legal_principles": [
    {
      "principle": "A wife who has a living spouse at the time of her marriage is not entitled to maintenance under Section 125 Cr.P.C.",
      "held": "It was held that under Section 12 of the Act, marriage of a woman with a man having a living spouse is a complete nullity and she is not entitled for benefit under Section 125 Cr.P.C.",
      "applicable_acts_sections": [
        "Hindu Marriage Act, 1955 — Section 12"
      ],
      "cited_cases": [
        "Yamunabai Anantrao Adhav Vs. Anantrao Shivram Adhav, AIR 1988 SC 644"
      ],
