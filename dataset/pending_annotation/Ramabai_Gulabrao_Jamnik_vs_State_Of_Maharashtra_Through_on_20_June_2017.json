  "legal_principles": [
    {
      "principle": "A petition for divorce under Section 13 of the Hindu Marriage Act, 1955 is maintainable only if there has been a breakdown of marriage.",
      "held": "It is held that a petition for divorce under Section 13 of the Hindu Marriage Act, 1955 is maintainable only if there has been a breakdown of marriage. The burden lies on the petitioner to prove that the marriage has broken down irretrievably.",
