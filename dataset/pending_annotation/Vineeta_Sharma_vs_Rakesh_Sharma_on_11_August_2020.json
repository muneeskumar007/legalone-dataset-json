  "legal_principles": [
    {
      "principle": "A widow's interest in coparcenary property merges into the coparcenary on her death if she does not exercise her right of partition.",
      "held": "If a widow does not exercise her right of partition, there is no severance of the Hindu coparcenary and on her death, the interest of the widow merges in the coparcenary property or lapses to the other coparceners.",
      "applicable_acts_sections": [
        "Hindu Succession Act, 1956"
      ],
