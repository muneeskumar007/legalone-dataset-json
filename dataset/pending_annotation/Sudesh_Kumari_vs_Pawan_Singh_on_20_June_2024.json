  "legal_principles": [
    {
      "principle": "Unless sufficient and cogent evidence is led showing that the person putting his signature on a document signed it for the purpose of attesting it or certifying that he has received from the executant a personal acknowledgement of his signature, he cannot be regarded as an attesting witness.",
      "held": "In the absence of any evidence in the case, signatures are appearing on the document only to certify that he is a scribe an identifier or a registering officer, he is not an attesting witness.",
      "applicable_acts_sections": [
        "Indian Evidence Act, 1872"
      ],
