  "legal_principles": [
    {
      "principle": "The second marriage is void ab initio and the second wife is not entitled to inherit the properties of the deceased husband.",
      "held": "According to Section 5 of the Hindu Marriage Act, 1955, the second marriage is void ab initio and the second wife is not entitled to inherit the properties of the deceased husband.",
