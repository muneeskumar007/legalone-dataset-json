  "legal_principles": [
    {
      "principle": "The expression 'any decree' in Section 25(1) does not include an order of dismissal.",
      "held": "It was viewed that the expression 'any decree' did not include an order of dismissal and that the passing of an order of dismissal of the petition could not be regarded as the passing of a decree within the meaning of Section 25.",
