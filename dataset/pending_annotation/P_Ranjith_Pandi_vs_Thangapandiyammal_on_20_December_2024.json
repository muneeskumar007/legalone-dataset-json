  "legal_principles": [
    {
      "principle": "Remarriage of the petitioner cannot be a reason to dismiss an application filed by the respondent for setting aside an ex parte decree.",
      "held": "Therefore, there is no legality or perversity in the order passed by the trial Court setting aside the ex parte decree of divorce passed against the respondent / wife after condoning the delay of 53 days in filing an application and prays for dismissing this Civil Revision Petition.",
