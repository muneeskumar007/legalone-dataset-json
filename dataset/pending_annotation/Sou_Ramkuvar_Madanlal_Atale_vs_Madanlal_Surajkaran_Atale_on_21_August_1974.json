  "legal_principles": [
    {
      "principle": "A consent decree for judicial separation is not a nullity if no appeal was filed against it.",
      "held": "The learned appellate Judge did not consider the aspect of nullity at all. The appeal was dismissed and that is how the wife has filed this appeal.",
