  "legal_principles": [
    {
      "principle": "When a Hindu marriage is solemnized in accordance with the provisions of Hindu Marriage Act, 1955, the State Governments are empowered to make rules for registration of such marriage.",
      "held": "In order to facilitate proof of such marriage by Section 8(1) of the Act, 1955, the State Governments are empowered to make rules for registration of such marriage.",
