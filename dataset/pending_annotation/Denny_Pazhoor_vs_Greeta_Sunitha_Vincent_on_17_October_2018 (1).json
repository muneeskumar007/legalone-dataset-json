  "legal_principles": [
    {
      "principle": "A spouse who has obtained a decree of divorce can lawfully marry again after the expiry of the time for filing an appeal or when an appeal is filed, after its dismissal.",
      "held": "These two sections make it clear that where a marriage has been dissolved, either party to the marriage can lawfully marry only when there is no right of appeal.",
