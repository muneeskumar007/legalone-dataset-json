  "legal_principles": [
    {
      "principle": "When a female Hindu inherits property, she has the right to deal with it as a full owner.",
      "held": "Section 15(2) of the Act does not impinge on her right to deal with properties of which she has become a full owner, on inheritance from her father-in-law.",
