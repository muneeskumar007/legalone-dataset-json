  "legal_principles": [
    {
      "principle": "A wife is entitled to receive an allowance for maintenance and expenses of proceeding from her husband if she is not living in adultery.",
      "held": "If a wife is living in adultery, or without sufficient reason refuses to live with her husband, or they are living separately by mutual consent, the Magistrate shall cancel the order.",
