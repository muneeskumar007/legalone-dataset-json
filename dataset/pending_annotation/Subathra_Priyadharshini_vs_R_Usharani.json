  "legal_principles": [
    {
      "principle": "A settlement deed executed by a person without any right in the property is not valid.",
      "held": "The defendant had no right to execute any settlement deed in favour of the defendants 4 and 5 and therefore, they were entitled to 3/6th share in the suit property.",
