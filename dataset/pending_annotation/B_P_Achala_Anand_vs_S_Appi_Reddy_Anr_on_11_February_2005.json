  "legal_principles": [
    {
      "principle": "A tenant's failure to pay or tender the whole of the arrears of rent legally recoverable from him within two months of the date of service of notice of demand provides a ground for eviction.",
      "held": "For our purpose, it would suffice to notice that vide clause (a) of sub-section (1) of Section 21 of the Act, the tenant's failure to pay or tender the whole of the arrears of rent legally recoverable from him within two months of the date of service of notice of demand on him in this regard provides a ground for eviction.",
