  "legal_principles": [
    {
      "principle": "A Family Court has jurisdiction to decide property disputes between spouses, but cannot cancel a sale deed executed in the name of a third party.",
      "held": "The Family Court has jurisdiction to decide the dispute between spouses including property disputes, but cannot cancel the sale deed executed in the name of the third party, who is not within the purview of the Family Court or within the meaning of the parties.",
