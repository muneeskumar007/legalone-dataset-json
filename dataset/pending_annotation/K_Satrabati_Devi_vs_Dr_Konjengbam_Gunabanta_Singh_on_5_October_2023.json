  "legal_principles": [
    {
      "principle": "A Family Court has jurisdiction to entertain a suit for declaration that the appellant is the single unmarried mother.",
      "held": "The suit or petition for declaration as single unmarried mother is squarely covered under Section 7(e) of the Family Courts Act and, thus, the Family Court has jurisdiction to entertain the suit.",
