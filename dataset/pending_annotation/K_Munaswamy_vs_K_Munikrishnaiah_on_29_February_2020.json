  "legal_principles": [
    {
      "principle": "There is no presumption that the properties held by a member of a Hindu undivided family constituted the joint family properties, with common possession and enjoyment, nor members so related constituted a joint family.",
      "held": "Therefore, the burden is on the appellants to prove and establish this fact of existence of a Hindu undivided family and that it owned properties.",
