  "legal_principles": [
    {
      "principle": "In a proceeding under Sections 9 to 13 of the Hindu Marriage Act, jurisdiction is fixed statutorily and does not depend on pecuniary value.",
      "held": "Jurisdiction is fixed statutorily under Section 19 of the HM Act read with Section 3(b) of HM Act and Notification dated 2-11-1971.",
