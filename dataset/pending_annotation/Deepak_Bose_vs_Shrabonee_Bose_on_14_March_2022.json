    {
      "principle": "Desertion is not a single act, but a continuous course of conduct.",
      "held": "Desertion, therefore, means withdrawing from the matrimonial obligations i.e. not permitting or allowing and facilitating the cohabitation between the parties.",
      "applicable_acts_sections": [
        "Hindu Marriage Act, 1955"
      ],
