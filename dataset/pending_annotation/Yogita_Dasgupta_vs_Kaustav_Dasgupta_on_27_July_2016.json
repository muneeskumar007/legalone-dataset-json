  "legal_principles": [
    {
      "principle": "The burden lies on the husband to prove that property acquired in his wife's name was not for her benefit.",
      "held": "The expression 'unless the contrary is proved' clearly places the onus of proving that this property was acquired not for the benefit of wife, upon the husband.",
